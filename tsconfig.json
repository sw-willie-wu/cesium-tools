{
  "compilerOptions": {
    "target": "ES2019",
    "declaration": true,
    "declarationDir": "types",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "Node",
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "composite": true
  },
  "include": ["src/**/*"]
}