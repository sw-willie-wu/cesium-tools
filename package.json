{
  "name": "cesium-tools",
  "version": "0.0.1",
  "description": "Cesium 工具函式庫，支援各種地圖操作與轉換功能",
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "types/index.d.ts",
  "files": [
    "lib",
    "types"
  ],
  "scripts": {
    "build:esm": "tsc --project tsconfig.esm.json",
    "build:cjs": "tsc --project tsconfig.cjs.json",
    "build": "npm run build:esm && npm run build:cjs",
    "build:no-cache": "rm -r lib && npm run build:esm && npm run build:cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sw-willie-wu/cesium-tools.git"
  },
  "author": "Willie. S.W. Wu",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "cesium": ">=1.120.0"
  },
  "dependencies": {
    "@turf/turf": "^7.2.0"
  }
}